# 복사해서 .env 로 쓴다 (.env 는 git 에서 제외). 셸 환경 변수가 있으면 그쪽이 우선.

# ── LLM (캡쳐 판독 정리 · 소비 습관 보고서 · 급여 분석 글) ──
# Claude Agent SDK: 비우면 로컬 Claude Code 로그인, 있으면 API 키
ANTHROPIC_API_KEY=
MLG_LLM_MODEL=claude-opus-5-5
# vLLM (OpenAI 호환 서버) — 예: http://127.0.0.1:8001/v1
MLG_VLLM_URL=
MLG_VLLM_API_KEY=

# ── OCR: Unlimited-OCR-2 (baidu/Unlimited-OCR-2, MIT) ──
# GPU 가 있는 곳에서 SGLang 으로 띄운 OpenAI 호환 주소 (docs/ocr.md). 비우면 캡쳐 판독은 Claude Vision 으로만 한다.
# 예: http://gpu-box:10000/v1
MLG_OCR_URL=
MLG_OCR_MODEL=Unlimited-OCR-2
MLG_OCR_API_KEY=
# 판독 방식: auto(OCR 서버가 있으면 OCR → LLM 정리, 없으면 Vision) · ocr · vision
MLG_OCR_MODE=auto

# ── LangSmith 로 트레이스 내보내기 (선택, `uv sync --extra langsmith`) ──
# 켜면 프롬프트(거래 · 금액)가 LangSmith 서버로 간다 → 키와 함께 MLG_LANGSMITH_EXPORT=1 을 직접 켜야 동작
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mallot-ledger
MLG_LANGSMITH_EXPORT=0
# MLG_TRACE=0      # 호출 추적(trace_spans) 끄기

# ── 접근 권한 (인터넷에 열 때 필수, docs/share.md) ──
# 관리자 비밀번호 해시 — `make admin-password` 가 넣는다 (평문 MLG_ADMIN_PASSWORD 도 되지만 비추천)
# Mallot Invest 와 다른 비밀번호 · 다른 쿠키(mlg_*)라 한쪽 로그인 · 손님 링크로는 다른 쪽에 들어가지 못한다.
MLG_ADMIN_PASSWORD_HASH=
# 1 이면 로그인을 언제나 요구 (scripts/share.sh 가 켠다). 쿠키 서명 비밀은 비우면 data/session_secret 을 만든다
# MLG_PUBLIC=1
# MLG_SESSION_SECRET=

# Mallot 홈 통합 대시보드 열쇠 (32자 이상) — 이 컴퓨터 안에서 GET /api/feed/* 만 로그인 없이 읽게 한다. 비우면 끔.
# mallot-home 의 systemd 유닛이 넣어 주므로 보통 여기 적지 않는다.
# MLG_FEED_TOKEN=

# ── 한 도메인 · Mallot 홈 통합 로그인 (mallot-home 이 묶어 띄울 때, docs/share.md) ──
# 경로 접두사 — 예: /ledger 면 <도메인>/ledger/ 아래에서 돈다 (프론트 빌드와 서버가 같이 쓴다). 비우면 지금처럼 루트.
MLG_BASE_PATH=
# Mallot 홈 로그인 서버 — 예: http://127.0.0.1:8300. 있으면 로그인 · 손님 공유를 홈이 맡고(MLG_FEED_TOKEN 필요),
# 앱 자체 로그인 · 공유 링크 API 는 409 로 닫는다. 비우면 위의 관리자 비밀번호 · 공유 링크를 그대로 쓴다.
MLG_HOME_AUTH_URL=


# ── 실행 ──
# MLG_DB_PATH=./data/ledger.db   # DB 위치 (캡쳐 이미지 · 실행 산출물도 이 폴더 아래)
# MLG_MODELS_DIR=~/path/to/models  # 이미 받은 로컬 LLM 모델 폴더를 같이 쓸 때
# MLG_SERVICES=0   # 백그라운드 서비스 끄기
